# apps/api reads these (copy to apps/api/.env)
DATABASE_URL=postgresql://loan_app:loan_app_local_only@localhost:5433/loans
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
PORT=4000
# Optional locally; required on AWS for document uploads
AWS_REGION=us-east-1
S3_BUCKET=loan-app-local-documents

# Local AWS emulator (optional; see README "AWS services locally")
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
JWT_SECRET_ID=loan-app/local/jwt-signing-key
SSM_PREFIX=/loan-app/local
KMS_KEY_ID=alias/loan-app-local
EVENT_BUS_NAME=loan-app-local-events
METRICS_ENABLED=true
